{
  "name": "mlx-personal-coding-pipeline",
  "version": "0.2.0",
  "description": "MLX — the personal coding dataset and model pipeline. Distinct from Apple's MLX project; not affiliated with or endorsed by Apple.",
  "private": true,
  "type": "module",
  "files": [
    "README.md",
    "mlx.package.json",
    "src/cli.tsx",
    "src/cli/**/*.ts",
    "src/core/**/*.ts"
  ],
  "bin": {
    "mlx": "./src/cli.tsx"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun src/cli.tsx",
    "pipeline": "bun src/cli.tsx pipeline",
    "test": "bun src/validation/process-entry.ts run test",
    "test:watch": "vitest",
    "test:integration": "bun src/validation/process-entry.ts external test:integration",
    "typecheck": "bun src/validation/process-entry.ts run typecheck",
    "check": "bun src/validation/process-entry.ts run check",
    "studio:build": "bun src/validation/process-entry.ts run studio:build",
    "dataset:validate": "bun src/validation/process-entry.ts run dataset:validate",
    "benchmark:smoke": "bun src/validation/process-entry.ts run benchmark:smoke",
    "local:check": "bun src/validation/process-entry.ts run local:check",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@huggingface/transformers": "^3.6.0",
    "acorn": "^8",
    "ai": "^6.0.168",
    "ajv": "^8.17.1",
    "fast-deep-equal": "^3.1.3",
    "gpt-tokenizer": "^2.9.0",
    "ink": "^5.2.0",
    "ink-spinner": "^5.0.0",
    "jsonschema": "latest",
    "p-limit": "^6",
    "react": "^18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
